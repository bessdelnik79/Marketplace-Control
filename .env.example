# Только для локальной разработки. Файл .env исключён из Git.
POSTGRES_DB=marketplace_control
POSTGRES_USER=marketplace_control
POSTGRES_PASSWORD=marketplace_control_local
POSTGRES_PORT=5432
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# false отключает email-код только вне production, для тестирования на VM.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Marketplace Control <no-reply@example.ru>
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
# 32 случайных байта в Base64. Сгенерируйте отдельно для каждой среды.
WB_TOKEN_ENCRYPTION_KEY=
